<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        LIGHT PALETTE. Same key set as Themes/Dark.xaml (colours only); control styles live in Themes/Controls.xaml.
        Values stay close to the original light look: WhiteSmoke panels, LightGray alternate rows, #b4c1fe selection.
    -->

    <!-- ===== Semantic theme brushes ===== -->
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ThemePanelBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="ThemeRaisedBrush" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="ThemeInputBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#FFABADB3" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="ThemeTextDisabledBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FF3C78D8" />
    <SolidColorBrush x:Key="ThemeLinkBrush" Color="#FF0066CC" />
    <SolidColorBrush x:Key="ThemeHoverBrush" Color="#FFDCE3FC" />
    <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#FFB4C1FE" />
    <SolidColorBrush x:Key="ThemeSelectedBorderBrush" Color="#FF6F86E8" />
    <SolidColorBrush x:Key="ThemePressedBrush" Color="#FFC4CEF6" />
    <SolidColorBrush x:Key="ThemeCheckMarkBrush" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#FFC2C3C9" />
    <SolidColorBrush x:Key="ThemeScrollThumbHoverBrush" Color="#FFA3A4AB" />
    <SolidColorBrush x:Key="ThemeScrollTrackBrush" Color="#FFEFEFEF" />

    <!-- ===== Legacy keys the views reference ===== -->
    <SolidColorBrush x:Key="VeryLightGray" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="LightGray" Color="#FFD3D3D3" />
    <SolidColorBrush x:Key="Gray" Color="#FF808080" />
    <SolidColorBrush x:Key="Light" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="White" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WhiteSmoke" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="TextColour" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="TextColourHighlight" Color="#FF0A0A0A" />
    <Color x:Key="SelectedListViewItemKey">#FFB4C1FE</Color>
    <SolidColorBrush x:Key="SelectedListViewItem" Color="#FFB4C1FE" />

    <!-- ===== Folder explorer expander arrow (original values) ===== -->
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Stroke" Color="#FF818181"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Fill" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Stroke" Color="#FF27C7F7"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Fill" Color="#FFCCEEFB"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Stroke" Color="#FF262626"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Fill" Color="#FF595959"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Stroke" Color="#FF1CC4F7"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Fill" Color="#FF82DFFB"/>

    <!-- ===== System brushes ===== -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFABADB3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFFFE1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFB4C1FE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFD3D9F8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#FF555555" />
</ResourceDictionary>
