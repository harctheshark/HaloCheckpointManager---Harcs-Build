<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        DARK PALETTE. This file holds colours only; Themes/Light.xaml defines exactly the same keys.
        All control styles/templates live in Themes/Controls.xaml and look every colour up with
        DynamicResource, so swapping this dictionary re-themes the whole app live (see App.ApplyTheme).

        window #1E1E24  panels #25252D  raised/headers #2D2D37  inputs #33333E  borders #44444F
        text #E4E4EA  secondary #A8A8B3  disabled #6C6C78  accent #8A6FD1
        hover #3A3350  selected #4A3D78  selected border #8A6FD1  pressed #55468A
    -->

    <!-- ===== Semantic theme brushes (used by Controls.xaml and the views) ===== -->
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FF1E1E24" />
    <SolidColorBrush x:Key="ThemePanelBrush" Color="#FF25252D" />
    <SolidColorBrush x:Key="ThemeRaisedBrush" Color="#FF2D2D37" />
    <SolidColorBrush x:Key="ThemeInputBrush" Color="#FF33333E" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#FF44444F" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#FFA8A8B3" />
    <SolidColorBrush x:Key="ThemeTextDisabledBrush" Color="#FF6C6C78" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FF8A6FD1" />
    <SolidColorBrush x:Key="ThemeLinkBrush" Color="#FFA790E6" />
    <SolidColorBrush x:Key="ThemeHoverBrush" Color="#FF3A3350" />
    <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#FF4A3D78" />
    <SolidColorBrush x:Key="ThemeSelectedBorderBrush" Color="#FF8A6FD1" />
    <SolidColorBrush x:Key="ThemePressedBrush" Color="#FF55468A" />
    <SolidColorBrush x:Key="ThemeCheckMarkBrush" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#FF4B4B58" />
    <SolidColorBrush x:Key="ThemeScrollThumbHoverBrush" Color="#FF6C6C78" />
    <SolidColorBrush x:Key="ThemeScrollTrackBrush" Color="#FF25252D" />

    <!-- ===== Legacy keys the views reference, mapped onto the roles above ===== -->
    <SolidColorBrush x:Key="VeryLightGray" Color="#FF25252D" />           <!-- panel -->
    <SolidColorBrush x:Key="LightGray" Color="#FF2D2D37" />               <!-- raised / alternate row -->
    <SolidColorBrush x:Key="Gray" Color="#FF44444F" />                    <!-- border -->
    <SolidColorBrush x:Key="Light" Color="#FF44444F" />                   <!-- border (detail panel outline) -->
    <SolidColorBrush x:Key="White" Color="#FF33333E" />                   <!-- input surface -->
    <SolidColorBrush x:Key="WhiteSmoke" Color="#FF25252D" />              <!-- panel / list background -->
    <SolidColorBrush x:Key="TextColour" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="TextColourHighlight" Color="#FFE4E4EA" />
    <Color x:Key="SelectedListViewItemKey">#FF4A3D78</Color>
    <SolidColorBrush x:Key="SelectedListViewItem" Color="#FF4A3D78" />

    <!-- ===== Folder explorer expander arrow ===== -->
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Stroke" Color="#FFA8A8B3"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Fill" Color="#FF25252D"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Stroke" Color="#FF8A6FD1"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Fill" Color="#FF3A3350"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Stroke" Color="#FFA8A8B3"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Fill" Color="#FFA8A8B3"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Stroke" Color="#FF8A6FD1"/>
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Fill" Color="#FF8A6FD1"/>

    <!-- ===== System brushes, so anything still using the stock keys reads correctly ===== -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2D2D37" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF3A3A46" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF44444F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF33333E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2D2D37" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2D2D37" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4A3D78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3F3566" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF6C6C78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#FFA8A8B3" />
</ResourceDictionary>
